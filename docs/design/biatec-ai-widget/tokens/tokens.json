{
  "$description": "Biatec AI design tokens. Mirrors tokens/biatec-tokens.css. Semantic name color.bg.primary -> CSS var --color-bg-primary.",
  "color": {
    "dark": {
      "bg.primary": "#070B14", "bg.secondary": "#111827", "bg.elevated": "#161E2E", "bg.interactive": "#1E293B",
      "text.primary": "#E6EDF6", "text.secondary": "#9AA7BA", "text.disabled": "#6B7A90",
      "border.default": "rgba(148,163,184,.14)", "border.strong": "rgba(148,163,184,.24)", "border.focus": "#2DD4A7",
      "brand.primary": "#2DD4A7", "brand.hover": "#4BE0B8", "brand.pressed": "#14B88A", "brand.subtle": "rgba(45,212,167,.14)", "brand.text": "#2DD4A7", "brand.on": "#04221A",
      "status.success": "#34D399", "status.success-subtle": "rgba(52,211,153,.14)",
      "status.warning": "#FBBF24", "status.warning-subtle": "rgba(251,191,36,.13)",
      "status.danger": "#FB7185", "status.danger-subtle": "rgba(251,113,133,.14)",
      "status.info": "#38BDF8", "status.info-subtle": "rgba(56,189,248,.14)",
      "status.neutral": "#9AA7BA", "scrim": "rgba(3,6,12,.72)"
    },
    "light": {
      "bg.primary": "#EEF2F6", "bg.secondary": "#FFFFFF", "bg.elevated": "#FFFFFF", "bg.interactive": "#E2E8F0",
      "text.primary": "#0F172A", "text.secondary": "#475569", "text.disabled": "#94A3B8",
      "border.default": "rgba(15,23,42,.1)", "border.strong": "rgba(15,23,42,.18)", "border.focus": "#0B8A60",
      "brand.primary": "#0EA371", "brand.hover": "#0B8A60", "brand.pressed": "#0A774F", "brand.subtle": "rgba(14,163,113,.12)", "brand.text": "#087453", "brand.on": "#04221A",
      "status.success": "#0F7A45", "status.success-subtle": "rgba(21,160,90,.12)",
      "status.warning": "#946200", "status.warning-subtle": "rgba(217,145,0,.12)",
      "status.danger": "#E11D48", "status.danger-subtle": "rgba(225,29,72,.1)",
      "status.info": "#0369A1", "status.info-subtle": "rgba(2,132,199,.1)",
      "status.neutral": "#475569", "scrim": "rgba(15,23,42,.45)"
    },
    "core": { "night": "#070B14", "card": "#111827", "panel": "#161E2E", "interactive": "#1E293B", "text": "#E6EDF6", "muted": "#9AA7BA", "biatecGreen": "#2DD4A7", "greenStrong": "#14B88A", "deepTeal": "#0F3B53", "sky": "#38BDF8", "ambientTeal": "#0A3247", "ambientGreen": "#0D5C46" }
  },
  "font": { "sans": "\"Inter\", -apple-system, \"Segoe UI\", system-ui, sans-serif", "script": "\"Pacifico\", cursive" },
  "type": {
    "display":    { "size": 40, "lineHeight": 48, "weight": 600, "letterSpacing": "-0.02em" },
    "h1":         { "size": 30, "lineHeight": 38, "weight": 600, "letterSpacing": "-0.015em" },
    "h2":         { "size": 23, "lineHeight": 30, "weight": 600, "letterSpacing": "-0.01em" },
    "h3":         { "size": 19, "lineHeight": 26, "weight": 600, "letterSpacing": "-0.005em" },
    "bodyLarge":  { "size": 16, "lineHeight": 26, "weight": 400 },
    "body":       { "size": 14, "lineHeight": 22, "weight": 400 },
    "supporting": { "size": 13, "lineHeight": 18, "weight": 400, "color": "text.secondary" },
    "dataLabel":  { "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": "0.04em", "textTransform": "uppercase", "color": "text.secondary" },
    "valueXL":    { "size": 32, "lineHeight": 36, "weight": 600, "letterSpacing": "-0.02em", "fontVariantNumeric": "tabular-nums" },
    "valueM":     { "size": 20, "lineHeight": 26, "weight": 600, "letterSpacing": "-0.01em", "fontVariantNumeric": "tabular-nums" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64 },
  "radius": { "tag": 6, "control": 8, "card": 12, "panel": 16, "full": 999, "cssVars": { "sm": 8, "md": 8, "lg": 13.6, "xl": 18.4 } },
  "shadow": {
    "dark":  { "sm": "0 1px 2px rgba(0,0,0,.4)", "md": "0 12px 32px -14px rgba(0,0,0,.7)", "lg": "0 28px 56px -22px rgba(0,0,0,.8)" },
    "light": { "sm": "0 1px 2px rgba(15,23,42,.06)", "md": "0 8px 24px -12px rgba(15,23,42,.25)", "lg": "0 24px 48px -20px rgba(15,23,42,.35)" }
  },
  "blur": 14,
  "motion": { "fast": "150ms", "base": "200ms", "slow": "220ms", "ease": "cubic-bezier(.2,0,0,1)" },
  "control": { "buttonHeights": [32, 40, 48], "iconButton": 40, "touchTarget": 44, "focusRing": "2px solid border.focus, offset 2px" }
}
