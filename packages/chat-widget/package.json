{
  "name": "@biatec/chat-widget",
  "version": "0.0.0",
  "description": "Embeddable Biatec Chat widget (Vue 3 plugin).",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/biatec-chat.umd.cjs",
  "module": "./dist/biatec-chat.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/biatec-chat.js",
      "require": "./dist/biatec-chat.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && node scripts/emit-types.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:playground": "vue-tsc --noEmit -p playground/tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@biatec/chat-protocol": "workspace:*",
    "@primeuix/themes": "^3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.6"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue-i18n": "^11.4.16"
  }
}
