{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biatec.io/consent/v1/consent-receipt-signed.schema.json",
  "title": "Signed receipt object",
  "description": "The object whose RFC 8785 canonical form the device key signs. Protocol 1.1 signs exactly eight members (nine when an approval carries `remember`); protocol 1.0 signed eight members that named the client differently (the `v1_0` branch).",
  "oneOf": [{ "$ref": "#/$defs/v1_1" }, { "$ref": "#/$defs/v1_0" }],
  "$defs": {
    "v1_1": {
      "title": "Signed receipt object, protocol 1.1",
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_details", "auth_req_id", "client_fingerprint", "binding_code", "decision", "expiry", "sub", "binding_message"],
      "allOf": [
        {
          "if": { "required": ["decision"], "properties": { "decision": { "enum": ["approve", "code_failed"] } } },
          "then": { "properties": { "binding_code": { "type": "string", "pattern": "^[0-9]{6}$" } } }
        },
        {
          "if": { "required": ["decision"], "properties": { "decision": { "const": "approve" } } },
          "else": { "properties": { "remember": false } }
        }
      ],
      "properties": {
        "authorization_details": { "$ref": "authorization-details.schema.json#/$defs/v1_1" },
        "auth_req_id": { "type": "string", "minLength": 16, "description": "Single-use nonce." },
        "client_fingerprint": { "$ref": "#/$defs/fingerprint", "description": "Fingerprint of the requesting client's client_id. Biatec OIDC vouches for no client: the receipt names the client by this value and the user decides on the phone." },
        "binding_code": { "type": "string", "pattern": "^([0-9]{6})?$", "description": "The code the user typed; the empty string for an explicit Deny before any code was typed." },
        "decision": { "enum": ["approve", "deny", "code_failed"] },
        "expiry": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Unix time in seconds." },
        "sub": { "type": "string", "minLength": 1, "description": "The pairwise subject of the requesting client." },
        "binding_message": { "type": "string", "maxLength": 140, "description": "Text as rendered on the card, or the empty string if none was rendered." },
        "remember": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applications"],
          "description": "Approve only. Applications of this request the user chose to trust for this client, signed with the approval itself (one biometric prompt covers both).",
          "properties": {
            "applications": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }
          }
        }
      }
    },
    "v1_0": {
      "title": "Signed receipt object, protocol 1.0",
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_details", "auth_req_id", "client_entity_id", "binding_code", "decision", "expiry", "sub", "binding_message"],
      "allOf": [
        {
          "if": { "required": ["decision"], "properties": { "decision": { "enum": ["approve", "code_failed"] } } },
          "then": { "properties": { "binding_code": { "type": "string", "pattern": "^[0-9]{6}$" } } }
        }
      ],
      "properties": {
        "authorization_details": { "$ref": "authorization-details.schema.json#/$defs/v1_0" },
        "auth_req_id": { "type": "string", "minLength": 16, "description": "Single-use nonce." },
        "client_entity_id": { "type": "string", "minLength": 1 },
        "binding_code": { "type": "string", "pattern": "^([0-9]{6})?$", "description": "The code the user typed; the empty string for an explicit Deny before any code was typed." },
        "decision": { "enum": ["approve", "deny", "code_failed"] },
        "expiry": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Unix time in seconds." },
        "sub": { "type": "string", "minLength": 1 },
        "binding_message": { "type": "string", "maxLength": 140, "description": "Text as rendered on the card, or the empty string if none was rendered." }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$", "description": "16 lowercase hex characters (64 bits) of the SHA-256 of the client_id, shown to the user as xxxx-xxxx-xxxx-xxxx." }
  }
}
