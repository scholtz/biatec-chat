<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Off by default; the chat-protocol generate script switches it on. -->
    <OpenApiGenerateDocuments Condition="'$(OpenApiGenerateDocuments)' == ''">false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\packages\chat-protocol</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Biatec.Chat.Core\Biatec.Chat.Core.csproj" />
    <ProjectReference Include="..\Biatec.Chat.Tools\Biatec.Chat.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\kb\**\*.md" Link="kb\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.BedrockAgentRuntime" Version="4.0.104" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.11" />
    <PackageReference Include="AWSSDK.KeyManagementService" Version="4.0.100.18" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.5" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.20" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.19" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.16.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AWS" Version="1.20.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.58" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
