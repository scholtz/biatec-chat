{
  "name": "@biatec/chat-widget",
  "version": "0.0.0",
  "description": "Embeddable Biatec Chat widget (Vue 3 plugin).",
  "type": "module",
  "license": "MIT",
  "files": ["dist"],
  "main": "./dist/biatec-chat.umd.cjs",
  "module": "./dist/biatec-chat.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/biatec-chat.js",
      "require": "./dist/biatec-chat.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && node scripts/emit-types.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@biatec/chat-protocol": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.21"
  }
}
