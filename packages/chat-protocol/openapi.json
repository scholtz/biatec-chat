  "components": {
    "schemas": {
      "ActionDecisionRequest": {
        "required": [
          "groupHash"
        ],
        "type": "object",
        "properties": {
          "groupHash": {
            "type": "string"
          }
        }
      },
      "ActionPreview": {
        "required": [
          "previewId",
          "capability",
          "intent",
          "network",
          "genesisId",
          "status",
          "steps",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "previewId": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "genesisId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ActionPreviewStatus"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionStep"
            }
          },
          "limit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LimitHeadroom"
              }
            ]
          },
          "expectsAuthenticatorApproval": {
            "type": "boolean"
          },
          "approvalReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActionPreviewStatus": {
        "enum": [
          "AwaitingConfirmation",
          "AwaitingScope",
          "AwaitingApproval",
          "Signing",
          "Submitted",
          "Completed",
          "Cancelled",
          "Expired",
          "Failed"
        ]
      },
      "ActionStep": {
        "required": [
          "stepId",
          "index",
          "title",
          "status",
          "groupHash"
        ],
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string"
          },
          "index": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ActionPreviewStatus"
          },
          "groupHash": {
            "type": "string"
          },
          "from": {
            "type": [
              "null",
              "string"
            ]
          },
          "to": {
            "type": [
              "null",
              "string"
            ]
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetAmount"
            }
          },
          "feeAmount": {
            "type": [
              "null",
              "string"
            ]
          },
          "slippagePercent": {
            "type": [
              "null",
              "string"
            ]
          },
          "simulationSummary": {
            "type": [
              "null",
              "string"
            ]
          },
          "transactionId": {
            "type": [
              "null",
              "string"
            ]
          },
          "explorerUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AdoptRequest": {
        "required": [
          "conversationId",
          "continuationToken"
        ],
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "continuationToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AgentModeValue": {
        "enum": [
          "analyze",
          "prepare"
        ]
      },
      "AgentSettings": {
        "required": [
          "agentMode",
          "paused"
        ],
        "type": "object",
        "properties": {
          "agentMode": {
            "$ref": "#/components/schemas/AgentModeValue"
          },
          "paused": {
            "type": "boolean"
          }
        }
      },
      "AgentSettingsRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentModeValue"
              }
            ]
          },
          "paused": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "AssetAmount": {
        "required": [
          "assetId",
          "symbol",
          "amount",
          "decimals"
        ],
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "decimals": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fiatValue": {
            "type": [
              "null",
              "string"
            ]
          },
          "fiatCurrency": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ConfirmRequest": {
        "type": "object",
        "properties": {
          "groupHash": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ConsentState": {
        "enum": [
          "NotRequired",
          "Pending",
          "Approved",
          "Denied",
          "TimedOut"
        ]
      },
      "ConsentStatus": {
        "required": [
          "previewId",
          "stepId",
          "state"
        ],
        "type": "object",
        "properties": {
          "previewId": {
            "type": "string"
          },
          "stepId": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ConsentState"
          },
          "bindingCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ContractCatalog": {
        "required": [
          "session",
          "suggestions",
          "chatRequest",
          "actionDecision",
          "event"
        ],
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionState"
          },
          "suggestions": {
            "$ref": "#/components/schemas/SuggestionList"
          },
          "chatRequest": {
            "$ref": "#/components/schemas/ChatMessageRequest"
          },
          "actionDecision": {
            "$ref": "#/components/schemas/ActionDecisionRequest"
          },
          "event": {
            "$ref": "#/components/schemas/ChatEvent"
          }
        }
      },
      "DataCardAsset": {
        "required": [
          "assetId",
          "unitName",
          "amount",
          "decimals"
        ],
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string"
          },
          "unitName": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "decimals": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fiatValue": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ConversationList": {
        "required": [
          "conversations"
        ],
        "type": "object",
        "properties": {
          "conversations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            }
          }
        }
      },
      "ConversationSummary": {
        "required": [
          "conversationId",
          "createdAt",
          "lastMessageAt",
          "current",
          "evidenceEntries"
        ],
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastMessageAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "current": {
            "type": "boolean"
          },
          "evidenceEntries": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ElevatePopupRequest": {
        "type": "object",
        "properties": {
          "scope": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ErasureResponse": {
        "required": [
          "status",
          "conversations",
          "payloadsDeleted"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "conversations": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "payloadsDeleted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "conversationId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HostContext": {
        "type": "object",
        "properties": {
          "route": {
            "type": [
              "null",
              "string"
            ]
          },
          "product": {
            "type": [
              "null",
              "string"
            ]
          },
          "locale": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChatEvent": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ChatEventTextDeltaEvent"
          },
          {
            "$ref": "#/components/schemas/ChatEventToolStatusEvent"
