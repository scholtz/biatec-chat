{
  "name": "@biatec/chat-widget",
  "version": "0.1.0",
  "description": "Embeddable Biatec AI chat widget: a Vue 3 plugin, plus a standalone build with Vue bundled for React, Docusaurus and plain HTML hosts.",
  "type": "module",
  "license": "MIT",
  "author": "Biatec Group",
  "homepage": "https://github.com/scholtz/biatec-chat/tree/main/packages/chat-widget#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scholtz/biatec-chat.git",
    "directory": "packages/chat-widget"
  },
  "bugs": {
    "url": "https://github.com/scholtz/biatec-chat/issues"
  },
  "keywords": [
    "biatec",
    "chat",
    "widget",
    "vue",
    "vue3",
    "algorand",
    "assistant",
    "docusaurus"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/biatec-chat.umd.cjs",
  "module": "./dist/biatec-chat.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/standalone/biatec-chat.standalone.iife.js",
  "jsdelivr": "./dist/standalone/biatec-chat.standalone.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/biatec-chat.js",
      "require": "./dist/biatec-chat.umd.cjs"
    },
    "./standalone": {
      "types": "./dist/standalone/index.d.ts",
      "default": "./dist/standalone/biatec-chat.standalone.js"
    },
    "./standalone/iife": "./dist/standalone/biatec-chat.standalone.iife.js",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/standalone/*.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vite build -c vite.standalone.config.ts && node scripts/emit-types.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:playground": "vue-tsc --noEmit -p playground/tsconfig.json",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biatec/chat-protocol": "workspace:*",
    "@primeuix/themes": "^3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "lucide-vue-next": "^1.0.0",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-i18n": "^11.4.16",
    "vue-tsc": "^3.0.6"
  }
}
