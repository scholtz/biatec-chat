{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biatec.io/consent/v1/backchannel-authentication-response.schema.json",
  "title": "Backchannel authentication response",
  "type": "object",
  "additionalProperties": false,
  "required": ["auth_req_id", "expires_in", "binding_code"],
  "properties": {
    "auth_req_id": { "type": "string", "minLength": 16 },
    "expires_in": { "type": "integer", "minimum": 1, "maximum": 300 },
    "interval": { "type": "integer", "minimum": 1 },
    "binding_code": { "$ref": "binding-code.schema.json" }
  }
}
