{
  // `tsc -p test-types` after `pnpm build` (run by test/standalone.test.ts): dist/standalone/index.d.ts matches the source.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "files": ["../src/shims.d.ts", "standalone.ts"]
}
